# Putanja do SQLite baze (relativno u odnosu na server/prisma)
DATABASE_URL="file:../data/planner.db"
# Port na kojem server slusa
PORT=3000
# Tajni kljuc za potpisivanje tokena za prijavu (promijeni u produkciji!)
JWT_SECRET="promijeni-me"
# Registracija je dozvoljena samo za prvog korisnika; postavi na true da je otvoris za sve
ALLOW_REGISTRATION=false
