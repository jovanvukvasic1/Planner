# Kopiraj u .env i popuni: cp .env.example .env

# Domen na kojem ce planer biti dostupan (npr. besplatni DuckDNS poddomen)
DOMAIN=mojplaner.duckdns.org

# Tajni kljuc za prijavu; generisi ga komandom: openssl rand -hex 32
JWT_SECRET=

# Registracija je otvorena samo za prvog korisnika; true = otvorena za sve
ALLOW_REGISTRATION=false
